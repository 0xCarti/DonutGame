; Idea #4: an original, decision-led concessions company simulator.
config_version=5

[application]
config/name="Golden Hour: On the Circuit"
config/version="0.2.0"
run/main_scene="res://scenes/circuit_main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="GoldenHourCircuit"

[display]
window/size/viewport_width=480
window/size/viewport_height=960
window/size/window_width_override=480
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/dpi/allow_hidpi=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.953,0.933,0.898,1)

[audio]
driver/enable_input=false

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false
